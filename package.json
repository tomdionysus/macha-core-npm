{
  "name": "@machafoundation/core",
  "version": "0.16.0",
  "description": "Generic, platform-independent client core for Macha: server API families, cluster endpoint routing and health, playback resolution and coordination, and persisted client state.",
  "license": "GPL-3.0-or-later",
  "author": "Tom Cully <tomhughcully@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomdionysus/macha-core-npm.git"
  },
  "bugs": {
    "url": "https://github.com/tomdionysus/macha-core-npm/issues"
  },
  "homepage": "https://github.com/tomdionysus/macha-core-npm#readme",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "HISTORY.md",
    "docs",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node -e \"for (const d of ['dist','dist.staging','dist.previous']) require('node:fs').rmSync(d, { recursive: true, force: true })\"",
    "build": "npm run typecheck && npm run lint:platform && node scripts/build-dist.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json --pretty false",
    "lint:platform": "tsc --noEmit -p tsconfig.nodom.json --pretty false",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "dist:check": "node scripts/dist-check.mjs",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "macha",
    "media",
    "client",
    "playback",
    "cluster"
  ]
}
